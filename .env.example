# إعدادات التطبيق
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# إعدادات الخادم
HOST=0.0.0.0
PORT=5000
DEBUG=True

# إعدادات قاعدة البيانات (اختياري للتطوير المستقبلي)
DATABASE_URL=sqlite:///tokens.db

# إعدادات الأمان
ENCRYPTION_KEY_FILE=secret.key
TOKENS_FILE=tokens.json

# إعدادات Discord API (للاختبارات المتقدمة)
DISCORD_API_BASE_URL=https://discord.com/api/v10